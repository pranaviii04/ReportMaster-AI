# ReportMaster AI — Environment Variables
# Copy this file to .env and fill in your real values before running the backend.
# NEVER commit the real .env file to source control.

# ── LLM / Google Gemini ───────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_key_here

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=financial_manuals

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K_RESULTS=5

# ── Document Chunking ─────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── User database (SQLite) ────────────────────────────────────────────────────
# Local default. On Railway with a volume mounted at /data:
# DATABASE_URL=sqlite:////data/reportmaster.db
DATABASE_URL=sqlite:///./data/reportmaster.db

# ── PDF manuals directory ─────────────────────────────────────────────────────
# On Railway: MANUALS_DIR=/data/manuals
# MANUALS_DIR=./data/manuals

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins (no trailing slashes). Local:
CORS_ORIGINS=http://localhost:3000
# Production example:
# CORS_ORIGINS=https://your-app.vercel.app

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a production secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=reportmaster_super_secret_key_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
