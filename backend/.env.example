# ReportMaster AI — Environment Variables
# Copy this file to .env and fill in your real values before running the backend.
# NEVER commit the real .env file to source control.

# ── LLM / Google Gemini ───────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_key_here

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=financial_manuals

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K_RESULTS=5

# ── Document Chunking ─────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── CORS (comma-separated list of allowed origins) ────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
